<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.StudentMapper">

    <!-- id 对应 StudentMapper 接口中的方法名；resultType 表示查询结果映射成 Student 对象。 -->
    <select id="findAll" resultType="Student">
        select id, name, age, phone
        from student
    </select>

    <!-- #{id} 是 MyBatis 的参数占位符，会使用预编译 SQL，能避免 SQL 注入风险。 -->
    <select id="findById" parameterType="int" resultType="Student">
        select id, name, age, phone
        from student
        where id = #{id}
    </select>

    <!-- 这里的 #{name}、#{age} 等会从 Student 对象的属性中取值。 -->
    <insert id="insertStudent" parameterType="Student">
        insert into student(id, name, age, phone)
        values(#{id}, #{name}, #{age}, #{phone})
    </insert>

    <!-- 根据 id 修改学生信息。调用前 Service 会把路径中的 id 设置到 Student 对象里。 -->
    <update id="updateStudent" parameterType="Student">
        update student
        set name = #{name},
        age = #{age},
        phone = #{phone}
        where id = #{id}
    </update>

    <!-- 根据 id 删除学生。 -->
    <delete id="deleteStudent" parameterType="int">
        delete from student
        where id = #{id}
    </delete>

</mapper>
