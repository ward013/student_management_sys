<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.TeacherMapper">

    <!-- 查询全部老师，用于管理员管理视图和前端老师工号参考区。 -->
    <select id="findAll" resultType="Teacher">
        select id, name, title, phone
        from teacher
        order by id asc
    </select>

    <!-- 添加老师时，数据库注入操作-->
    <insert id="insertTeacher">
        insert into teacher(id, name,title,phone)
        values(#{id},#{name},#{title},#{phone})
    </insert>
    <!-- 更新教师信息-->
    <update id="updateTeacher">
        update teacher
        set id=#{id},
            name=#{name},
            title=#{title},
            phone=#{phone}
        where id=#{id}
    </update>
    <!-- 根据工号查询单个老师。#{id} 是 MyBatis 的参数占位符，会使用预编译 SQL。 -->
    <select id="findById" parameterType="int" resultType="Teacher">
        select id, name, title, phone
        from teacher
        where id = #{id}
    </select>
</mapper>
